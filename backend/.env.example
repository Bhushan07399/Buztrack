PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://buztrack_user:buztrack_password@localhost:5432/buztrack_db
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_in_production
STORAGE_DRIVER=local # local | s3 | gcs
OCR_PROVIDER=mock # mock | google_vision | tesseract
PAYMENT_GATEWAY_PROVIDER=mock # mock | razorpay | cashfree
NOTIFICATION_PROVIDER=mock # mock | fcm
